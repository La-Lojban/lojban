{
  "name": "lojban",
  "version": "2.0.48",
  "description": "Lojban language parsers and tools",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "assets"
  ],
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "dumper": "tsx src/bangu/dumper.ts",
    "compile": "node src/cmaxes/src/compiler.cjs",
    "build": "rm -rf dist && pnpm run dumper && pnpm run compile && tsc",
    "prep": "pnpm version --patch && pnpm run build",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:coverage:check": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "test/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "jest": {
    "testMatch": [
      "<rootDir>/test/**/*.ts",
      "<rootDir>/test/**/*.js"
    ],
    "transform": {
      "\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "js",
      "json",
      "node"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/cmaxes/cmaxes.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "lines": 90,
        "functions": 90,
        "branches": 90,
        "statements": 90
      }
    }
  },
  "author": "Gleki",
  "license": "ISC",
  "dependencies": {
    "peggy": "^3.0.2",
    "ramda": "^0.32.0"
  },
  "pnpm": {
    "overrides": {
      "peggy": "^3.0.2"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/ramda": "^0.31.1",
    "eslint": "^10.0.3",
    "eslint-plugin-jest": "^29.15.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fs-extra": "^11.3.4",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^16.4.0",
    "mkdirp": "^3.0.1",
    "path-extra": "^4.3.0",
    "prettier": "^3.8.1",
    "stream-json": "^1.9.1",
    "ts-jest": "^29.4.6",
    "ts-pegjs": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  }
}
